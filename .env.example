# Copy to .env for local development. On Vercel, set these in Project Settings > Environment Variables.

# 32+ random characters. Generate: python -c "import secrets; print(secrets.token_hex(32))"
OTTO_SECRET_KEY=

# PostgreSQL. Vercel's Neon integration sets DATABASE_URL for you; use the pooled connection string.
DATABASE_URL=postgresql://otto:otto@localhost:5432/otto

# Inbox that receives new bookings and website requests.
OTTO_AGENCY_EMAIL=andi@theottoagency.com

OTTO_TIMEZONE=America/New_York

# Keeps the sign-in cookie off plain http. Leave it true in production.
# Set OTTO_SECURE_COOKIES=false in your own .env only while testing on http://localhost,
# otherwise the browser drops the cookie and every form answers "this form expired".
OTTO_SECURE_COOKIES=true

# Outgoing mail. Leave OTTO_SMTP_HOST empty to log emails instead of sending them.
# Turbify business mail (the current inbox): smtp.bizmail.yahoo.com on port 465,
# the full address as the username, and an app password from Turbify Mail settings.
OTTO_SMTP_HOST=
OTTO_SMTP_PORT=465
OTTO_SMTP_USERNAME=
OTTO_SMTP_PASSWORD=
OTTO_SMTP_SENDER=

# Optional: reminder texts to the owner's phone (Twilio). Leave all three blank to log them instead.
OTTO_TWILIO_ACCOUNT_SID=
OTTO_TWILIO_AUTH_TOKEN=
OTTO_TWILIO_FROM=

# Vercel does not create this. Set it to a random string of 16+ characters in the project's
# environment variables; Vercel then sends it as a Bearer token when the cron runs. The
# reminder route refuses to run without it, so it cannot be triggered by a stranger.
CRON_SECRET=

# Only for running tests/test_app.py: an empty, throwaway database (its tables are dropped).
OTTO_TEST_DATABASE_URL=
